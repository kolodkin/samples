FROM python:3.11-slim

WORKDIR /app

# `docker` SDK lets the runner resolve sidecar compose-service names to
# host-side cgroup paths so it can sum memory.peak / cpu.stat across all
# containers doing real work (aaiclick client + clickhouse + postgres +
# fileserver). See distributed_data_libs/stats.py.
RUN pip install --no-cache-dir aaiclick==0.0.16 clickhouse-connect pyarrow docker

COPY distributed_data_libs ./distributed_data_libs

ENV PYTHONPATH=/app
ENV FRAMEWORK=aaiclick
