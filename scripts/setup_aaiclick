#!/usr/bin/env bash
# One entry point for every backend an example project needs, so a run script
# can provision its dependencies with a single line.
#
#   scripts/setup_aaiclick            # distributed backend: ClickHouse + PostgreSQL + migrations
#   scripts/setup_aaiclick --local    # embedded backend instead: chdb + SQLite, no servers
#   scripts/setup_aaiclick --ollama   # local Ollama server holding the configured model
#   scripts/setup_aaiclick --ai       # AI provider only: pull the model / check the API key
#
# Flags combine (`--local --ai`, `--ollama` implies `--ai`). Every step is
# probe-first and idempotent: a backend that already answers is left alone, so
# CI (databases as service containers) runs the same command as a laptop with
# nothing installed and pays only for the migrations.
#
# Connection contract (override via env; matches setup_clickhouse / setup_postgres):
#   AAICLICK_CH_URL    clickhouse://default:benchmark@localhost:8123/default
#   AAICLICK_SQL_URL   postgresql+asyncpg://aaiclick:secret@localhost:5432/aaiclick
#   AAICLICK_AI_MODEL  ollama/llama3.1:8b

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

LOCAL=0 OLLAMA=0 AI=0
while [ $# -gt 0 ]; do
    case "$1" in
        --local)  LOCAL=1 ;;
        --ollama) OLLAMA=1; AI=1 ;;
        --ai)     AI=1 ;;
        -h|--help) sed -n '2,19p' "$0" | cut -c3- ; exit 0 ;;
        *) echo "Unknown flag: $1" >&2; exit 1 ;;
    esac
    shift
done

CH_URL="${AAICLICK_CH_URL:-clickhouse://default:benchmark@localhost:8123/default}"
SQL_URL="${AAICLICK_SQL_URL:-postgresql+asyncpg://aaiclick:secret@localhost:5432/aaiclick}"

# scheme://user:pass@host:port/db -> the four parts each caller needs. Set as
# _USER/_PASS/_HOST/_PORT/_DB so a caller can pick what it wants off one call.
parse_url() {
    local rest="${1#*://}" creds="" hostport
    case "$rest" in *@*) creds="${rest%%@*}"; rest="${rest#*@}" ;; esac
    hostport="${rest%%/*}"
    _USER="${creds%%:*}"; _PASS="${creds#*:}"
    _HOST="${hostport%%:*}"; _PORT="${hostport##*:}"
    _DB="${rest#*/}"
}

tcp_open() { (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null; }

if [ "$LOCAL" -eq 1 ]; then
    # Embedded mode is selected by the *absence* of server URLs, so drop any a
    # caller exported before handing off to aaiclick's own local setup.
    echo "Setting up the embedded backend (chdb + SQLite)..."
    env -u AAICLICK_SQL_URL -u AAICLICK_CH_URL \
        ${PYTHON:-uv run python} -m aaiclick setup
else
    parse_url "$CH_URL"; CH_HOST="$_HOST" CH_PORT="$_PORT" CH_PASS="$_PASS"
    if curl -sf "http://${CH_HOST}:${CH_PORT}/ping" &>/dev/null; then
        echo "ClickHouse already reachable at ${CH_HOST}:${CH_PORT} — skipping install."
    else
        CH_PASSWORD="$CH_PASS" "$SCRIPT_DIR/setup_clickhouse"
    fi

    parse_url "$SQL_URL"
    if tcp_open "$_HOST" "$_PORT"; then
        # A server we did not provision (a CI service container, a real cluster)
        # holds no aaiclick schema; setup_postgres migrates the ones it creates.
        echo "PostgreSQL already reachable at ${_HOST}:${_PORT} — applying migrations only."
        AAICLICK_SQL_URL="$SQL_URL" \
        POSTGRES_HOST="$_HOST" POSTGRES_PORT="$_PORT" POSTGRES_USER="$_USER" \
        POSTGRES_PASSWORD="$_PASS" POSTGRES_DB="$_DB" \
            uv run --with aaiclick --with asyncpg --with psycopg2-binary \
                python -m aaiclick migrate upgrade head
    else
        POSTGRES_PORT="$_PORT" POSTGRES_USER="$_USER" \
        POSTGRES_PASSWORD="$_PASS" POSTGRES_DB="$_DB" \
            "$SCRIPT_DIR/setup_postgres"
    fi
fi

if [ "$OLLAMA" -eq 1 ]; then
    "$SCRIPT_DIR/setup_ollama"
elif [ "$AI" -eq 1 ]; then
    MODEL="${AAICLICK_AI_MODEL:-ollama/llama3.1:8b}"
    case "$MODEL" in
        ollama/*)
            # `aaiclick setup --ai` pulls the model but cannot install a server.
            if ! curl -sf "${OLLAMA_HOST:-http://localhost:11434}/api/version" &>/dev/null; then
                echo "ERROR: no Ollama server for '${MODEL}'. Run scripts/setup_ollama," >&2
                echo "       or point AAICLICK_AI_MODEL / AAICLICK_AI_API_KEY at a hosted model." >&2
                exit 1
            fi
            "$SCRIPT_DIR/setup_ollama"
            ;;
        *)
            if [ -z "${AAICLICK_AI_API_KEY:-}" ]; then
                echo "ERROR: AAICLICK_AI_MODEL='${MODEL}' is a hosted model but" >&2
                echo "       AAICLICK_AI_API_KEY is unset." >&2
                exit 1
            fi
            echo "AI provider ready (model=${MODEL}, hosted)."
            ;;
    esac
fi
