# Copy to config.env and fill in. All OCIDs are in the OCI console; the
# easiest way to collect them is "Save as stack" on the failed Create Instance
# review page, then open the stack's Terraform config — it contains every value.

# Identity > Compartments (root compartment OCID works for free tier)
COMPARTMENT_OCID="ocid1.tenancy.oc1..xxxx"

# Full AD name, e.g. "Xxxx:IL-JERUSALEM-1-AD-1"
# (oci iam availability-domain list)
AVAILABILITY_DOMAIN="xxxx:IL-JERUSALEM-1-AD-1"

# Networking > Virtual Cloud Networks > your VCN > Subnets
SUBNET_OCID="ocid1.subnet.oc1.il-jerusalem-1.xxxx"

# The OS image you picked, e.g. Ubuntu 24.04 aarch64
# (oci compute image list --compartment-id ... --operating-system "Canonical Ubuntu" --shape VM.Standard.A1.Flex)
IMAGE_OCID="ocid1.image.oc1.il-jerusalem-1.xxxx"

# Public key that will be authorized for ssh
SSH_PUB_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# Optional overrides (defaults shown). Always Free A1 quota: 2 OCPUs / 12 GB total.
#SHAPE="VM.Standard.A1.Flex"
#OCPUS=2
#MEMORY_GB=12
#BOOT_VOLUME_GB=50
#DISPLAY_NAME="a1-free"
#RETRY_SECONDS=90
