# Everything here is OPTIONAL — copy to config.env only to override a default.
# The script reads the tenancy from the OCI CLI config you authenticated with,
# then discovers the availability domains, subnet and newest matching image.

# Pin these only if discovery picks the wrong resource (e.g. several subnets):
#COMPARTMENT_OCID="ocid1.compartment.oc1..xxxx"   # default: tenancy root
#AVAILABILITY_DOMAIN="xxxx:IL-JERUSALEM-1-AD-1"   # default: try every AD in turn
#SUBNET_OCID="ocid1.subnet.oc1.il-jerusalem-1.xxxx"
#IMAGE_OCID="ocid1.image.oc1.il-jerusalem-1.xxxx" # default: newest OS_NAME/OS_VERSION for the shape

# Public key authorized on the instance.
# Default: ./authorized_key.pub, then ~/.ssh/id_ed25519.pub, then ~/.ssh/id_rsa.pub
#SSH_PUB_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# Instance shape and sizing. Always Free A1 quota: 2 OCPUs / 12 GB total.
#SHAPE="VM.Standard.A1.Flex"
#OCPUS=1        # up to 2; smaller requests land more often
#MEMORY_GB=6    # up to 12
#BOOT_VOLUME_GB=50
#DISPLAY_NAME="a1-free"
#OS_NAME="Canonical Ubuntu"
#OS_VERSION="24.04"

# Retry behaviour
#RETRY_SECONDS=90
#MAX_ATTEMPTS=0   # 0 = retry forever; >0 = exit 2 after N capacity failures
